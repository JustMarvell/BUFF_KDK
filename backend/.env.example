DJANGO_SECRET_KEY=change-me-to-a-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL/PostGIS connection
PGHOST=localhost
PGPORT=5432
PGDATABASE=kostfinder
PGUSER=kostfinder_user
PGPASSWORD=changeme

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OSRM routing server. Free public demo for dev/small projects
# (rate-limited, not for production), or your own docker-hosted OSRM.
OSRM_BASE_URL=https://router.project-osrm.org

VITE_GOOGLE_MAPS_API_KEY=key
